# 复制为 .env 后按实际情况填写；.env 已被 .gitignore 忽略，不会进仓库。
# 启动时由 env_loader.py 自动读取（纯标准库，不需要额外依赖）；
# 也可以在启动前手动 export 这些变量，手动设置的环境变量优先级更高。

# ===== 服务端：数据库连接 =====
# 格式：mysql+pymysql://用户名:口令@主机:端口/库名?charset=utf8mb4
CMDB_DATABASE_URL=mysql+pymysql://root:你的口令@127.0.0.1:3306/cmdb?charset=utf8mb4
# 设为 1 会打印所有 SQL，排查问题时用
CMDB_DB_ECHO=0

# ===== 采集客户端（agent）=====
# 服务端上报接口地址，被采集主机上要填服务端的真实 IP
CMDB_SERVER_URL=http://127.0.0.1:8888/api/v1/host/report
# 上报间隔（秒）
CMDB_REPORT_INTERVAL=30
